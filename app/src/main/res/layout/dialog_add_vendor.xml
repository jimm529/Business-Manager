<?xml version="1.0" encoding="utf-8"?>
<!-- Register Vendor dialog: the vendor form, a server error line, and Cancel / Register buttons. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            style="@style/Widget.Marketplace.CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vendors_add_title" />

        <TextView
            style="@style/Widget.Marketplace.SettingsLabel"
            android:text="@string/vendors_add_company" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCompany"
            style="@style/Widget.Marketplace.SettingsField">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCompany"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Widget.Marketplace.SettingsLabel"
            android:text="@string/vendors_add_license" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLicense"
            style="@style/Widget.Marketplace.SettingsField">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLicense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Widget.Marketplace.SettingsLabel"
            android:text="@string/vendors_add_location" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLocation"
            style="@style/Widget.Marketplace.SettingsField">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Widget.Marketplace.SettingsLabel"
            android:text="@string/vendors_add_material" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMaterial"
            style="@style/Widget.Marketplace.SettingsField">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMaterial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Widget.Marketplace.SettingsLabel"
            android:text="@string/vendors_add_volume" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilVolume"
            style="@style/Widget.Marketplace.SettingsField">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Widget.Marketplace.SettingsLabel"
            android:text="@string/vendors_add_certification" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCertification"
            style="@style/Widget.Marketplace.SettingsField">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCertification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Widget.Marketplace.SettingsLabel"
            android:text="@string/vendors_add_compliance_status" />

        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Marketplace.SettingsDropdown">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/ddComplianceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Widget.Marketplace.SettingsLabel"
            android:text="@string/vendors_add_manager" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilManager"
            style="@style/Widget.Marketplace.SettingsField">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etManager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Widget.Marketplace.SettingsLabel"
            android:text="@string/vendors_add_email" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail"
            style="@style/Widget.Marketplace.SettingsField">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textEmailAddress"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Server message, e.g. "Please provide a valid secure email address" -->
        <TextView
            android:id="@+id/tvVendorError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="?attr/colorError"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressVendor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorSize="24dp"
                app:trackThickness="3dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVendorCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_dialog_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVendorSubmit"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vendors_add_submit" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
