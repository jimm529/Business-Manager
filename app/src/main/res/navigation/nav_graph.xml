<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.marketplace.ui.auth.LoginFragment"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.marketplace.ui.auth.RegisterFragment"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_register_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- The four bottom-navigation tabs -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.marketplace.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/marketFragment"
        android:name="com.example.marketplace.ui.market.MarketFragment"
        android:label="@string/nav_market"
        tools:layout="@layout/fragment_market" />

    <fragment
        android:id="@+id/messagesFragment"
        android:name="com.example.marketplace.ui.messages.MessagesFragment"
        android:label="@string/nav_messages"
        tools:layout="@layout/fragment_messages">
        <action
            android:id="@+id/action_messages_to_chat"
            app:destination="@id/chatFragment" />
    </fragment>

    <!-- Messages flow: thread -> chat -> deal (Counter Price) -> Offer Accepted -->
    <fragment
        android:id="@+id/chatFragment"
        android:name="com.example.marketplace.ui.messages.ChatFragment"
        android:label="@string/nav_messages"
        tools:layout="@layout/fragment_chat">
        <argument
            android:name="conversationId"
            app:argType="string" />
        <argument
            android:name="participantName"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="participantSubtitle"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="batchNumber"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <action
            android:id="@+id/action_chat_to_counterPrice"
            app:destination="@id/counterPriceFragment" />
    </fragment>

    <fragment
        android:id="@+id/counterPriceFragment"
        android:name="com.example.marketplace.ui.messages.CounterPriceFragment"
        android:label="@string/counter_title"
        tools:layout="@layout/fragment_counter_price">
        <argument
            android:name="bidId"
            app:argType="string" />
        <argument
            android:name="conversationId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="batchNumber"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <!-- After accepting, Back from the confirmation returns to the chat, not to the finished deal. -->
        <action
            android:id="@+id/action_counterPrice_to_offerAccepted"
            app:destination="@id/offerAcceptedFragment"
            app:popUpTo="@id/counterPriceFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/offerAcceptedFragment"
        android:name="com.example.marketplace.ui.messages.OfferAcceptedFragment"
        android:label="@string/offer_accepted_title"
        tools:layout="@layout/fragment_offer_accepted">
        <argument
            android:name="transactionId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="itemDetail"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="quantity"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="agreedRate"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="totalContractValue"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="status"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="batchNumber"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <!-- Settings tab: Operator Settings -->
    <fragment
        android:id="@+id/operatorSettingsFragment"
        android:name="com.example.marketplace.ui.settings.OperatorSettingsFragment"
        android:label="@string/settings_title"
        tools:layout="@layout/fragment_operator_settings" />

    <!-- Used when the server rejects the saved token (401) or the user logs out:
         show Login and forget every other screen. -->
    <action
        android:id="@+id/action_global_loginFragment"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <!-- Used after login/register and when the app starts with a saved login:
         show Home and forget Login, so Back does not return to it. -->
    <action
        android:id="@+id/action_global_homeFragment"
        app:destination="@id/homeFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />
</navigation>
