<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.marketplace.ui.auth.LoginFragment"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.marketplace.ui.auth.RegisterFragment"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_register_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- The bottom-navigation tabs (Home, Market, Messages, More; the Action (+) button opens Registered Vendors) -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.marketplace.ui.home.HomeHostFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home_host">
        <!-- Vendor Home: open the conversation of a negotiation -->
        <action
            android:id="@+id/action_home_to_chat"
            app:destination="@id/chatFragment" />
    </fragment>

    <fragment
        android:id="@+id/marketFragment"
        android:name="com.example.marketplace.ui.market.MarketFragment"
        android:label="@string/nav_market"
        tools:layout="@layout/fragment_market">
        <action
            android:id="@+id/action_market_to_placeOrder"
            app:destination="@id/placeOrderFragment" />
    </fragment>

    <!-- The full Place Order page for one lot (operator only) -->
    <fragment
        android:id="@+id/placeOrderFragment"
        android:name="com.example.marketplace.ui.market.PlaceOrderFragment"
        android:label="@string/po_title"
        tools:layout="@layout/fragment_place_order">
        <argument
            android:name="lotId"
            app:argType="string" />
        <action
            android:id="@+id/action_placeOrder_to_chat"
            app:destination="@id/chatFragment" />
    </fragment>

    <fragment
        android:id="@+id/messagesFragment"
        android:name="com.example.marketplace.ui.messages.MessagesFragment"
        android:label="@string/nav_messages"
        tools:layout="@layout/fragment_messages">
        <action
            android:id="@+id/action_messages_to_chat"
            app:destination="@id/chatFragment" />
    </fragment>

    <!-- More tab: a menu that opens Orders, Purchase History and Operator Settings -->
    <fragment
        android:id="@+id/moreFragment"
        android:name="com.example.marketplace.ui.more.MoreFragment"
        android:label="@string/more_title"
        tools:layout="@layout/fragment_more">
        <action
            android:id="@+id/action_more_to_vendorSales"
            app:destination="@id/vendorSalesFragment" />
        <action
            android:id="@+id/action_more_to_vendorSettings"
            app:destination="@id/vendorSettingsFragment" />
        <action
            android:id="@+id/action_more_to_orders"
            app:destination="@id/ordersFragment" />
        <action
            android:id="@+id/action_more_to_purchaseHistory"
            app:destination="@id/purchaseHistoryFragment" />
        <action
            android:id="@+id/action_more_to_operatorSettings"
            app:destination="@id/operatorSettingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/ordersFragment"
        android:name="com.example.marketplace.ui.orders.OrdersFragment"
        android:label="@string/orders_title"
        tools:layout="@layout/fragment_orders" />

    <fragment
        android:id="@+id/purchaseHistoryFragment"
        android:name="com.example.marketplace.ui.history.PurchaseHistoryFragment"
        android:label="@string/history_title"
        tools:layout="@layout/fragment_purchase_history" />

    <!-- Messages flow: thread -> chat -> deal (Counter Price) -> Offer Accepted -->
    <fragment
        android:id="@+id/chatFragment"
        android:name="com.example.marketplace.ui.messages.ChatFragment"
        android:label="@string/nav_messages"
        tools:layout="@layout/fragment_chat">
        <argument
            android:name="conversationId"
            app:argType="string" />
        <argument
            android:name="participantName"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="participantSubtitle"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="batchNumber"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <action
            android:id="@+id/action_chat_to_counterPrice"
            app:destination="@id/counterPriceFragment" />
    </fragment>

    <fragment
        android:id="@+id/counterPriceFragment"
        android:name="com.example.marketplace.ui.messages.CounterPriceFragment"
        android:label="@string/counter_title"
        tools:layout="@layout/fragment_counter_price">
        <argument
            android:name="bidId"
            app:argType="string" />
        <argument
            android:name="conversationId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="batchNumber"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <!-- After accepting, Back from the confirmation returns to the chat, not to the finished deal. -->
        <action
            android:id="@+id/action_counterPrice_to_offerAccepted"
            app:destination="@id/offerAcceptedFragment"
            app:popUpTo="@id/counterPriceFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/offerAcceptedFragment"
        android:name="com.example.marketplace.ui.messages.OfferAcceptedFragment"
        android:label="@string/offer_accepted_title"
        tools:layout="@layout/fragment_offer_accepted">
        <argument
            android:name="transactionId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="itemDetail"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="quantity"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="agreedRate"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="totalContractValue"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="status"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="batchNumber"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <!-- Round Action (+) button in the bottom bar: Registered Vendors -->
    <fragment
        android:id="@+id/registeredVendorsFragment"
        android:name="com.example.marketplace.ui.vendors.RegisteredVendorsFragment"
        android:label="@string/vendors_title"
        tools:layout="@layout/fragment_registered_vendors">
        <action
            android:id="@+id/action_vendors_to_inventory"
            app:destination="@id/vendorInventoryFragment" />
    </fragment>

    <!-- A registered vendor's Inventory (operator only): profile, live lots, custom quote -->
    <fragment
        android:id="@+id/vendorInventoryFragment"
        android:name="com.example.marketplace.ui.vendorinventory.VendorInventoryFragment"
        android:label="@string/vinv_title"
        tools:layout="@layout/fragment_vendor_inventory">
        <argument
            android:name="vendorId"
            app:argType="string" />
        <argument
            android:name="vendorName"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <action
            android:id="@+id/action_vendorInventory_to_chat"
            app:destination="@id/chatFragment" />
    </fragment>

    <!-- Opened from the More menu: Operator Settings -->
    <fragment
        android:id="@+id/operatorSettingsFragment"
        android:name="com.example.marketplace.ui.settings.OperatorSettingsFragment"
        android:label="@string/settings_title"
        tools:layout="@layout/fragment_operator_settings" />

    <!-- Vendor-only screens (the operator cannot open these). Placeholders until the pages are designed. -->
    <fragment
        android:id="@+id/vendorRequestsFragment"
        android:name="com.example.marketplace.ui.vendorrequests.VendorRequestsFragment"
        android:label="@string/nav_requests"
        tools:layout="@layout/fragment_vendor_requests" />

    <fragment
        android:id="@+id/vendorListingsFragment"
        android:name="com.example.marketplace.ui.listing.VendorListingFragment"
        android:label="@string/nav_listings"
        tools:layout="@layout/fragment_vendor_listing" />

    <!-- Vendor Sales History (vendor only), opened from the More menu -->
    <fragment
        android:id="@+id/vendorSalesFragment"
        android:name="com.example.marketplace.ui.vendorsales.VendorSalesFragment"
        android:label="@string/sales_title"
        tools:layout="@layout/fragment_vendor_sales" />

    <!-- Vendor Settings (vendor only), opened from the More menu -->
    <fragment
        android:id="@+id/vendorSettingsFragment"
        android:name="com.example.marketplace.ui.vendorsettings.VendorSettingsFragment"
        android:label="@string/vsettings_title"
        tools:layout="@layout/fragment_vendor_settings" />

    <!-- Notifications (both roles): opened from the bell on any screen -->
    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.example.marketplace.ui.notifications.NotificationsFragment"
        android:label="@string/notifications_title"
        tools:layout="@layout/fragment_notifications">
        <action
            android:id="@+id/action_notifications_to_chat"
            app:destination="@id/chatFragment" />
    </fragment>

    <action
        android:id="@+id/action_global_notifications"
        app:destination="@id/notificationsFragment" />

    <!-- Used when the server rejects the saved token (401) or the user logs out:
         show Login and forget every other screen. -->
    <action
        android:id="@+id/action_global_loginFragment"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <!-- Used after login/register and when the app starts with a saved login:
         show Home and forget Login, so Back does not return to it. -->
    <action
        android:id="@+id/action_global_homeFragment"
        app:destination="@id/homeFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />
</navigation>
