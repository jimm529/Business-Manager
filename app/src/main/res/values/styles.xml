<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Small bold caption above a field, e.g. EMAIL ADDRESS -->
    <style name="Widget.Marketplace.FieldLabel" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Outlined text field with the web design's small corners -->
    <style name="Widget.Marketplace.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">6dp</item>
        <item name="boxCornerRadiusTopEnd">6dp</item>
        <item name="boxCornerRadiusBottomStart">6dp</item>
        <item name="boxCornerRadiusBottomEnd">6dp</item>
        <item name="boxStrokeColor">?attr/colorPrimary</item>
        <item name="hintEnabled">false</item>
    </style>

    <style name="Widget.Marketplace.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="cornerRadius">6dp</item>
    </style>

    <style name="Widget.Marketplace.SocialButton" parent="Widget.Material3.Button.OutlinedButton.Icon">
        <item name="android:minHeight">44dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="cornerRadius">6dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="iconTint">@null</item>
    </style>

    <style name="Widget.Marketplace.TextLink" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Bottom bar: one tab, its icon and its label (selected state comes from setSelected) -->
    <style name="Widget.Marketplace.NavTab" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.Marketplace.NavIcon" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:tint">@color/nav_item_color</item>
    </style>

    <style name="Widget.Marketplace.NavLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/nav_item_color</item>
    </style>

    <!-- Small bold section title on the dashboard -->
    <style name="Widget.Marketplace.SectionTitle" parent="">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Text link on the right of a section title, e.g. VIEW ALL -->
    <style name="Widget.Marketplace.SectionAction" parent="">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
